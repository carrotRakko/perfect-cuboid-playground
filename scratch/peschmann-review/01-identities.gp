\\ 01-identities.gp : symbolic checks of the parametrisation identities in paper 1 (2604.09328) and paper 2 (2604.28072)
default(parisize, 64000000);
U1 = a^2-b^2; V1 = 2*a*b; W1 = a^2+b^2;
U2 = m^2-n^2; V2 = 2*m*n; W2 = m^2+n^2;
print("== e-brick (paper 2 form): edges e1=U1U2, e2=V1U2, e3=U1V2");
print("d12^2 - (W1U2)^2 = ", (U1*U2)^2+(V1*U2)^2-(W1*U2)^2);
print("d13^2 - (U1W2)^2 = ", (U1*U2)^2+(U1*V2)^2-(U1*W2)^2);
print("Hsum = e1^2+e2^2+e3^2 - [W1^2U2^2+U1^2V2^2] = ", (U1*U2)^2+(V1*U2)^2+(U1*V2)^2 - (W1^2*U2^2+U1^2*V2^2));
print("Hsum symmetric under (a,b)<->(m,n)? ", (W1^2*U2^2+U1^2*V2^2) - (W2^2*U1^2+U2^2*V1^2));
print("Master symmetric? ", (V1*U2)^2+(U1*V2)^2 - ((V2*U1)^2+(U2*V1)^2));
print();
print("== conic reduction: rho = t - 1/t, t = m/n; rho = 2U2/V2");
rho = 2*U2/V2; t = m/n;
print("rho - (t-1/t) = ", rho - (t-1/t));
print("Hsum   * 4/V2^2 - (W1^2 rho^2 + 4U1^2) = ", (W1^2*U2^2+U1^2*V2^2)*4/V2^2 - (W1^2*rho^2+4*U1^2));
print("Master * 4/V2^2 - (V1^2 rho^2 + 4U1^2) = ", ((V1*U2)^2+(U1*V2)^2)*4/V2^2 - (V1^2*rho^2+4*U1^2));
print("rho^2+4 - (t+1/t)^2 = ", rho^2+4 - (t+1/t)^2);
print();
print("== conic parametrisation of Hsum-conic Y^2 = W1^2 rho^2 + 4U1^2 by lambda");
rho = 4*U1*lam/(W1*(1-lam^2)); Y = 2*U1*(1+lam^2)/(1-lam^2);
print("Y^2 - (W1^2 rho^2 + 4U1^2) = ", Y^2 - (W1^2*rho^2+4*U1^2));
f1 = W1^2*(lam^2-1)^2 + 4*U1^2*lam^2;
f2 = W1^2*(lam^2-1)^2 + 4*V1^2*lam^2;
print("[rho^2+4] * W1^2(1-lam^2)^2/4 - f1 = ", (rho^2+4)*W1^2*(1-lam^2)^2/4 - f1, "   (so f1 = square <=> t rational)");
print("[V1^2rho^2+4U1^2] * W1^2(1-lam^2)^2/(4U1^2) - f2 = ", (V1^2*rho^2+4*U1^2)*W1^2*(1-lam^2)^2/(4*U1^2) - f2, "   (so f2 = square <=> Master)");
print("lambda in terms of (t,F): slope of line through (0,2U1): lambda = (Y-2U1)/(W1 rho); check: ", (Y-2*U1)/(W1*rho) - lam);
print();
print("== L-brick picture: (2U1 lam, 2V1 lam, W1(lam^2-1))");
print("L1^2+L2^2 - (2W1 lam)^2 = ", (2*U1*lam)^2+(2*V1*lam)^2-(2*W1*lam)^2);
print("L1^2+L2^2+L3^2 - (W1(lam^2+1))^2 = ", (2*U1*lam)^2+(2*V1*lam)^2+(W1*(lam^2-1))^2-(W1*(lam^2+1))^2);
print("L1^2+L3^2 - f1 = ", (2*U1*lam)^2+(W1*(lam^2-1))^2 - f1);
print("L2^2+L3^2 - f2 = ", (2*V1*lam)^2+(W1*(lam^2-1))^2 - f2);
print();
print("== normalised quartics");
c = (U1^2-V1^2)/W1^2; A = 2-4*c^2;
print("f1/W1^2 - (lam^4+2c lam^2+1) = ", f1/W1^2 - (lam^4+2*c*lam^2+1));
print("f2/W1^2 - (lam^4-2c lam^2+1) = ", f2/W1^2 - (lam^4-2*c*lam^2+1));
print("f1 f2/W1^4 - (lam^8 + A lam^4 + 1) = ", f1*f2/W1^4 - (lam^8+A*lam^4+1));
s = a/b;
print("c - (s^4-6s^2+1)/(1+s^2)^2 = ", c - (s^4-6*s^2+1)/(1+s^2)^2);
kap = 4*a*b*(a^2-b^2)/(a^2+b^2)^2;
print("c^2+kappa^2-1 = ", c^2+kap^2-1);
print("1+kappa - ((a^2+2ab-b^2)/W1)^2 = ", 1+kap - ((a^2+2*a*b-b^2)/W1)^2);
print("1-kappa - ((a^2-2ab-b^2)/W1)^2 = ", 1-kap - ((a^2-2*a*b-b^2)/W1)^2);
print("A+2 - 4 kappa^2 = ", A+2-4*kap^2, "   (A = -2 iff kappa = 0 iff s in {0,+-1,oo})");
print("prop 6.1: A^2-4 - 16c^2(c^2-1) = ", A^2-4 - 16*c^2*(c^2-1), " ; 1-c^2 - 16 s^2 (s^2-1)^2/(1+s^2)^4 = ", 1-c^2 - 16*s^2*(s^2-1)^2/(1+s^2)^4);
print("Remark 2.4 factorisation (14): ph=4s/(1+s^2), ps=2(s^2-1)/(1+s^2)");
ph = 4*s/(1+s^2); ps = 2*(s^2-1)/(1+s^2);
print("ph^2+ps^2-4 = ", ph^2+ps^2-4);
prod14 = (lam^2+ph*lam+1)*(lam^2-ph*lam+1)*(lam^2+ps*lam+1)*(lam^2-ps*lam+1);
print("f1 f2/W1^4 - prod(14) = ", f1*f2/W1^4 - prod14);
print("f1/W1^2 - (lam^2+ph lam+1)(lam^2-ph lam+1) = ", f1/W1^2 - (lam^2+ph*lam+1)*(lam^2-ph*lam+1));
print("f1/W1^2 - (lam^2+ps lam+1)(lam^2-ps lam+1) = ", f1/W1^2 - (lam^2+ps*lam+1)*(lam^2-ps*lam+1));
print("f2/W1^2 - (lam^2+ps lam+1)(lam^2-ps lam+1) = ", f2/W1^2 - (lam^2+ps*lam+1)*(lam^2-ps*lam+1));
print();
print("== E_A: y^2=(x+A)(x-2)(x+2) vs quartic w^2 = mu^4 + A mu^2 + 1, with M := mu^2 = 4(x+A)/(x^2-4)");
Aa = 'Aa;
M = 4*(x+Aa)/(x^2-4); val = M^2 + Aa*M + 1;
print("numerator(M^2 + A M + 1) factored: ", factor(numerator(val)));
print("denominator: ", factor(denominator(val)));
print("  -> w = (x^2 + 2 A x + 4 A + 4)/(x^2-4) [sign aside]?  check: ", val - ((x^2+2*Aa*x+4*Aa+4)/(x^2-4))^2);
print();
print("== Theorem 5.4 (a),(b): translation by 2-torsion. E_A over Q(A).");
E = ellinit([0, Aa, 0, -4, -4*Aa]);  \\ y^2 = x^3 + A x^2 - 4x - 4A = (x+A)(x-2)(x+2)
print("check E_A: ", E.a2, " ", E.a4, " ", E.a6, "  disc = ", factor(E.disc));
T1 = [-Aa, 0]; T2 = [2, 0]; T3 = [-2, 0];
fP(P) = 2*P[2]/((P[1]-2)*(P[1]+2));
\\ generic point P=(x,y) with y^2 = cubic: use the relation to reduce
cub = x^3 + Aa*x^2 - 4*x - 4*Aa;
red(expr) = { my(nn = numerator(expr), dd = denominator(expr)); nn = substpol(nn, y^2, cub); dd = substpol(dd, y^2, cub); nn/dd; };
P = [x, y];
foreach([T1,T2,T3], T, my(PT = elladd(E, P, T), ratio = red(fP(PT)/fP(P))); print("f(P+T)/f(P) for T=", T, " : ", ratio, "   ;  f(P)^2 = ", red(fP(P)^2)));
print();
print("== Theorem 6.2(a) claim: with x+A = d alpha^2, x-2 = d beta^2, x+2 = gamma^2:  f = 2 alpha/(beta gamma)");
print("   f is a square iff 2 alpha beta gamma is a square; the paper's '2 alpha/(beta gamma) == 2 mod squares' needs alpha beta gamma to be a square, which is not implied.");
print();
print("== paper 2 identities");
P2(S) = V2^2*S^2 + (4*U2^2-2*V2^2)*S + V2^2;
Q2(S) = W2^2*S^2 + 2*(U2^2-V2^2)*S + W2^2;
print("b^4 P(t^2) - Master (t=a/b): ", b^4*P2((a/b)^2) - ((V1*U2)^2+(U1*V2)^2));
print("b^4 Q(t^2) - Hsum   (t=a/b): ", b^4*Q2((a/b)^2) - (W1^2*U2^2+U1^2*V2^2));
print("disc P - 16 U2^2 (U2^2-V2^2) = ", poldisc(P2(S), S) - 16*U2^2*(U2^2-V2^2));
print("disc Q + 16 U2^2 V2^2 = ", poldisc(Q2(S), S) + 16*U2^2*V2^2);
print("Res(P,Q) factored = ", factor(polresultant(P2(S), Q2(S), S))); print("Res(P,Q) - 256 U2^4 V2^4 = ", polresultant(P2(S), Q2(S), S) - 256*U2^4*V2^4); print("Res(P,Q)/(256 U2^4) = ", polresultant(P2(S), Q2(S), S)/(256*U2^4));
print("coefficient of t^6 in P(t^2)Q(t^2): ", polcoef(P2(tt^2)*Q2(tt^2), 6, tt), " = 4U2^2W2^2-4V2^4 ? ", polcoef(P2(tt^2)*Q2(tt^2), 6, tt) - (4*U2^2*W2^2-4*V2^4));
Lf = W1*W2 - V1*V2; Rf = W1*W2 + V1*V2;
print("f1 - L R = ", (W1^2*U2^2+U1^2*V2^2) - Lf*Rf);
print("L - ((am-bn)^2+(an-bm)^2) = ", Lf - ((a*m-b*n)^2+(a*n-b*m)^2));
print("R - ((am+bn)^2+(an+bm)^2) = ", Rf - ((a*m+b*n)^2+(a*n+b*m)^2));
print("E_3 quartic from H via w=t-1/t: P(t^2)/t^2 - (V2^2 w^2 + 4U2^2) with w=t-1/t: ", P2(t^2)/t^2 - (V2^2*(t-1/t)^2+4*U2^2), " ; Q: ", Q2(t^2)/t^2 - (W2^2*(t-1/t)^2+4*U2^2));
print("E_uV quartic via u=t+1/t: P: ", P2(t^2)/t^2 - (V2^2*(t+1/t)^2+4*(U2^2-V2^2)), " ; Q: ", Q2(t^2)/t^2 - (W2^2*(t+1/t)^2-4*V2^2));
print("paper 3 tau: quartic s^2 = V2^2 t^4 + (4U2^2-2V2^2) t^2 + V2^2 ; X = 2 gam (s+gam)/t^2, tau = 4 gam^2 (X+B)/(X^2-4 gam^4)");
gam = V2; B3 = 4*U2^2-2*V2^2;
Xc = 2*gam*(ss+gam)/t^2; tau = 4*gam^2*(Xc+B3)/(Xc^2-4*gam^4);
print("tau - t^2 [mod ss^2 = quartic] = ", red2 = (numerator(tau - t^2)));
print("   substituting ss^2 -> quartic: ", substpol(numerator(tau-t^2), ss^2, P2(t^2)));
